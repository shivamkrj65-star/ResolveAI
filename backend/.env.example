# ResolveAI Environment Variables
# Copy to .env and adjust as necessary

# Server configuration
PROJECT_NAME="ResolveAI"
PORT=8000
HOST="127.0.0.1"

# Google Gemma / Gemini API (Optional for live LLM extraction; mock fallback included)
GEMMA_API_KEY=""

# n8n Automation Engine Webhook URL (Optional; internal workflow engine activates if unset)
N8N_WEBHOOK_URL=""

# Hybrid Duplicate Detection Settings
SEMANTIC_SIMILARITY_THRESHOLD=0.50
HYBRID_DUPLICATE_THRESHOLD=0.58
VISUAL_DUPLICATE_THRESHOLD=0.88

# Image uploads (backend only — never expose API_SECRET in Vite/browser variables)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER_PREFIX="campus-problems"
MAX_IMAGES_PER_CASE=4
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_PIXELS=24000000
MAX_IMAGE_DIMENSION=1920
MIN_IMAGE_DIMENSION=48
BLUR_VARIANCE_THRESHOLD=18

# Notion documentation synchronisation (backend only)
NOTION_API_KEY=""
# Use one of PARENT_PAGE_ID, DATABASE_ID, or a known existing DOCUMENTATION_PAGE_ID.
NOTION_PARENT_PAGE_ID=""
NOTION_DATABASE_ID=""
NOTION_DOCUMENTATION_PAGE_ID=""

# Role-Based Demo Authentication (Backend only — never expose in frontend)
ADMIN_USERNAME="admin_resolve"
ADMIN_PASSWORD="MapleFox47"
TESTER_USERNAME="tester_resolve"
TESTER_PASSWORD="OrbitPanda82"
SESSION_SECRET="resolveai-demo-secret-key-change-in-production"
COOKIE_SECURE=false

# Optional hardening for administrative status, merge, and Notion-sync endpoints.
# Leave blank only for the local hackathon demo; configure a secret in deployments.
ADMIN_API_TOKEN=""
SUBMISSION_RATE_LIMIT_PER_MINUTE=20
